\newcommand{\hseSupervisorName}{%
{{ project.supervisor.name | default('') | texesc }}}
\newcommand{\hseSupervisorTitle}{%
{{ project.supervisor.title | default('') | texesc }}}
\newcommand{\hseSupervisorDegree}{%
{{ project.supervisor.degree | default('') | texesc }}}
\newcommand{\hseCoSupervisorName}{%
{{ project.co_supervisor.name | default('') | texesc }}}
\newcommand{\hseCoSupervisorTitle}{%
{{ project.co_supervisor.title | default('') | texesc }}}
\newcommand{\hseCoSupervisorDegree}{%
{{ project.co_supervisor.degree | default('') | texesc }}}

% ── Титул ВКР (доп. поля; есть разумные значения по умолчанию) ─
% Используются только в vkr/title.tex. Академический руководитель ОП
