\newcommand{\hseUDC}{%
{{ project.meta.udc | default('004') | texesc }}}
\newcommand{\hseProgramCode}{%
{{ project.meta.program_code | default('09.03.04') | texesc }}}
\newcommand{\hseCourse}{%
{{ project.meta.course | default('4') | texesc }}}
% Уровень подготовки на титуле («N курса …») — шаблон только бакалаврский.
\newcommand{\hseDegreeLevel}{бакалавриата}
\newcommand{\hseAcademicSupervisorName}{%
{{ project.academic_supervisor.name | default('Н. А. Павлочев') | texesc }}}
\newcommand{\hseAcademicSupervisorTitle}{%
{{ project.academic_supervisor.title | default('Академический руководитель образовательной программы «Программная инженерия», старший преподаватель департамента программной инженерии') | texesc }}}

% ── Базовый код документа ЕСПД (ГОСТ 19.103-77) ─────────────
% Каждый документ ЕСПД добавляет к нему свой суффикс, например:
%   \newcommand{\doccode}{\hseDocCodeBase\ ТЗ 01-1}
\newcommand{\hseDocCodeBase}{%
{{ project.meta.doc_code_base | default('RU.XXXXXXXX.XX.XX-XX') | texesc }}}

% ── Руководства в «Составе программной документации» (пер-автор) ────
% Мета `manuals` (select: «Программиста и оператора» / «Только программиста»
% / «Только оператора») задаёт, какие руководства входят в комплект автора.
% Макрос раскрывается в \item'ы для перечня в ТЗ. По умолчанию — оба. В
% team-проекте meta.tex перегенерируется per-автор, поэтому у каждого свой
% набор. Значение подставляется как есть (это не пользовательский текст, а
% фиксированная опция), сопоставление — по подстроке.
\newcommand{\hseManualDocItems}{%
((* set _man = (project.meta.manuals | default('Программиста и оператора', true)) | lower *))
((* if 'программиста' in _man *))\item «\projectname». Руководство программиста (ГОСТ~19.504-79).
((* endif *))((* if 'оператора' in _man *))\item «\projectname». Руководство оператора (ГОСТ~19.505-79).
((* endif *))}

% ── Плейсхолдер «заполните сами» ────────────────────────────
% Жёлтая подсветка мест, которые студент заменяет своим содержимым:
%   \hseFill{укажите используемые языки программирования}
% Печатается как <текст> на жёлтом фоне — сразу видно, что дописать.
% Каждое слово в своём \colorbox, между ними обычные пробелы — длинный
% плейсхолдер переносится по словам и не вылезает за поле (сплошной
% \colorbox не разрывается, а soul теряет слова из аргумента макроса).
\ExplSyntaxOn
\ProvideDocumentCommand{\hseFill}{m}
 {
  \group_begin:
  \setlength{\fboxsep}{1.5pt}
  \seq_set_split:Nnn \l_tmpa_seq { ~ } { <#1> }
  \seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq { \colorbox{yellow!50}{##1} }
  \seq_use:Nn \l_tmpb_seq { ~ }
  \group_end:
 }
% \hseOptional{…} — та же подсветка, но без угловых скобок: готовый текст,
% который оставляют как есть или удаляют, если к проекту не относится.
\ProvideDocumentCommand{\hseOptional}{m}
 {
  \group_begin:
  \setlength{\fboxsep}{1.5pt}
  \seq_set_split:Nnn \l_tmpa_seq { ~ } { #1 }
  \seq_set_map:NNn \l_tmpb_seq \l_tmpa_seq { \colorbox{yellow!50}{##1} }
  \seq_use:Nn \l_tmpb_seq { ~ }
  \group_end:
 }
\ExplSyntaxOff

% ── Булевы флаги для условной печати ────────────────────────
\newif\ifhseHasSupervisorTitle
((* if project.supervisor.title *))\hseHasSupervisorTitletrue((* else *))\hseHasSupervisorTitlefalse((* endif *))
\newif\ifhseHasCoSupervisor
((* if project.co_supervisor.name *))\hseHasCoSupervisortrue((* else *))\hseHasCoSupervisorfalse((* endif *))
% Английское название задано (титул презентации печатает его отдельной
% строкой; \hseProjectNameEn с жёлтым плейсхолдером тут не годится).
\newif\ifhseHasNameEn
((* if project.meta.name_en *))\hseHasNameEntrue((* else *))\hseHasNameEnfalse((* endif *))
% E-mail владельца базы задан (финальный слайд презентации).
\newif\ifhseHasAuthorEmail
((* if author.email or (project.authors and project.authors[0].email) *))\hseHasAuthorEmailtrue((* else *))\hseHasAuthorEmailfalse((* endif *))
% Командный режим: \ifhseTeam — проект командный; \ifhseSharedDoc — эта база
% несёт ОБЩИЕ документы (shared/): их титулы печатают весь состав команды.
\newif\ifhseTeam
((* if team.is_team *))\hseTeamtrue((* else *))\hseTeamfalse((* endif *))
\newif\ifhseSharedDoc
((* if team.is_shared_base *))\hseSharedDoctrue((* else *))\hseSharedDocfalse((* endif *))

% ── Блок исполнителей для ЛУ ЕСПД-документов ────────────────
% title_template.tex печатает его внутри flushright. Личная база / solo —
% один исполнитель (владелец комплекта, токены идентичны прежней вёрстке);
% shared-база — строка подписи на КАЖДОГО автора: общее ТЗ подписывает вся
% команда.
\newcommand{\hseExecutorsBlock}{%
((* if team.is_shared_base *))\textbf{Исполнители:}
((* for a in project.authors *))
студент группы {{ a.group | default('') | texesc }}

\vspace{0.2cm}

\authorsignatureline{7cm} {{ a.name | texesc }}

\vspace{0.1cm}

\signdateblank
((* if not loop.last *))
\vspace{0.35cm}
((* endif *))((* endfor *))((* else *))\textbf{Исполнитель:}

студент группы \studentgroup

\vspace{0.2cm}

\authorsignatureline{7cm} \studentname

\vspace{0.1cm}

\signdateblank((* endif *))}
