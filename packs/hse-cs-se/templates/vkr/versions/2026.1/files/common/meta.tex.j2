% ((# ============================================================ #))
% ((# common/meta.tex — АВТОГЕНЕРИРУЕМЫЙ ФАЙЛ. НЕ РЕДАКТИРОВАТЬ.    #))
% ((#                                                              #))
% ((# Тул перегенерирует его из .hse-studio/project.json ПЕРЕД      #))
% ((# каждой сборкой. Здесь все ИЗМЕНЯЕМЫЕ данные проекта (ФИО,     #))
% ((# группа, год, руководитель, NDA…) в виде макросов \hse…       #))
% ((# Документы используют эти макросы вместо литералов, поэтому    #))
% ((# правка данных в настройках сразу попадает в PDF, а твои       #))
% ((# правки в .tex никто не трогает.                               #))
% ((#                                                              #))
% ((# Источник: common/meta.tex.j2 (см. dynamic_includes в         #))
% ((# version.yaml). Двухстрочная форма \newcommand{..}{%<NL>val}   #))
% ((# нужна, чтобы избежать последовательности «{{{» — её Jinja     #))
% ((# принял бы за открытие выражения.                              #))
% ((# ============================================================ #))

% ── Проект ──────────────────────────────────────────────────
% В командном проекте каждая база (папка автора / shared) получает СВОЙ
% meta.tex: \hseProjectName в личной базе — тема автора («Серверная часть
% Системы X»), в shared-базе и solo — название проекта. \hseSystemName —
% всегда общее название системы (для ссылок на неё из личных доков).
\newcommand{\hseProjectName}{%
((* if author.topic *)){{ author.topic | texesc }}((* else *)){{ project.name | texesc }}((* endif *))}
\newcommand{\hseSystemName}{%
{{ project.name | texesc }}}

% ── Наименования программы: английское и краткое ────────────
% Задаются метой name_en / name_short. Пустое значение → жёлтый
% \hseFill-плейсхолдер прямо в PDF: сразу видно, что поле нужно
% заполнить в настройках проекта.
\newcommand{\hseProjectNameEn}{%
((* if project.meta.name_en *)){{ project.meta.name_en | texesc }}((* else *))\hseFill{укажите название на английском в настройках проекта}((* endif *))}
\newcommand{\hseProjectNameShort}{%
((* if project.meta.name_short *)){{ project.meta.name_short | texesc }}((* else *))\hseFill{укажите краткое наименование в настройках проекта}((* endif *))}

% ── Автор (владелец базы) ───────────────────────────────────
% Solo и личная база team — владелец комплекта; shared-база — первый автор
% (титулы общих доков печатают весь состав через \hseExecutorsBlock).
\newcommand{\hseAuthorName}{%
((* if author.name *)){{ author.name | texesc }}((* elif project.authors *)){{ project.authors[0].name | texesc }}((* endif *))}
% E-mail владельца базы (финальный слайд презентации); пусто — не печатается.
\newcommand{\hseAuthorEmail}{%
((* if author.email *)){{ author.email | texesc }}((* elif project.authors *)){{ project.authors[0].email | default('') | texesc }}((* endif *))}

% ── Все авторы (для командных работ) ────────────────────────
% \hseAuthorsList — ФИО через запятую; \hseAuthorsCount — их число.
% Документы scope=shared могут печатать весь состав, не только первого.
\newcommand{\hseAuthorsList}{%
((* for a in project.authors *)){{ a.name | texesc }}((* if not loop.last *)), ((* endif *))((* endfor *))}
\newcommand{\hseAuthorsCount}{%
{{ project.authors | length }}}

% ── Учебные метаданные ──────────────────────────────────────
% Группа — у владельца базы (solo: единственный автор); отдельного
% мета-поля нет, источник один: карточка автора.
\newcommand{\hseGroup}{%
((* if author.group *)){{ author.group | texesc }}((* elif project.authors *)){{ project.authors[0].group | default('') | texesc }}((* endif *))}
\newcommand{\hseYear}{%
{{ project.meta.year | default('') | texesc }}}
% Шаблон бакалаврский: уровень подготовки вшит (магистратура — другой
% комплект документов и другой шаблон), мета-поля degree_type больше нет.
\newcommand{\hseDegreeType}{Бакалавриат}
\newcommand{\hseSpecialization}{%
{{ project.meta.specialization | default('') | texesc }}}
\newcommand{\hseFaculty}{%
{{ project.meta.faculty | default('Факультет компьютерных наук') | texesc }}}
\newcommand{\hseCity}{%
{{ project.meta.city | default('Москва') | texesc }}}

