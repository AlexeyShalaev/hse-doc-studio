% ── Плотный лист утверждения ────────────────────────────────
% Общий документ команды печатает строку подписи на каждого автора. При
% трёх и более авторах, а также при двух авторах с соруководителем лист
% утверждения не вмещает весь состав, поэтому он набирается плотнее:
%   \hseFormGap{<отступ>}  вертикальный отступ листа: в плотном листе вдвое
%                          меньше, иначе как задан;
%   \hseApprovalTight      в плотном листе убирает отступы между абзацами и
%                          вокруг блоков center/flushright (title_template
%                          вызывает его внутри группы листа утверждения).
% В остальных случаях (solo, личные документы, два автора без
% соруководителя) лист печатается как раньше.
((* set hse_n_authors = project.authors | length *))
((* set hse_compact = team.is_shared_base and (hse_n_authors >= 3 or (hse_n_authors >= 2 and project.co_supervisor.name)) *))
\newcommand{\hseFormGap}[1]{%
((* if hse_compact *))\vspace{\dimexpr(#1)/2\relax}((* else *))\vspace{#1}((* endif *))}
\newcommand{\hseApprovalTight}{%
((* if hse_compact *))\setlength{\parskip}{0pt}\setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}((* endif *))}

% ── Блок исполнителей для ЛУ ЕСПД-документов ────────────────
% title_template.tex печатает его внутри flushright. Личная база / solo —
% один исполнитель (владелец комплекта, якорь подписи `author` стоит в
% \authorsignatureline); shared-база — строка подписи на КАЖДОГО автора:
% общий документ подписывает вся команда. У строки каждого автора свой
% якорь подписи author__<slug автора> и свои якоря даты (день и месяц):
% Студия ставит рамку подписи каждого автора на его линию. Строки одного
% автора не разрываются между страницами (\nobreak): если лист не вмещает
% весь состав, на следующую страницу уходит блок автора целиком.
% Подписи блока печатаются на языке проекта.
% \hseExecutorSignLine{<якорь>}, \hseExecutorDateLine{<якорь>}: линия подписи
% 7 см и строка даты с якорями; без common/anchors печатаются без якорей.
\newcommand{\hseExecutorSignLine}[1]{\ifdefined\hseSignAnchor\hseSignAnchor[7cm]{#1}\fi\rule{7cm}{0.4pt}}
\newcommand{\hseExecutorDateLine}[1]{«\ifdefined\hseDateAnchor\hseDateAnchor[0.8cm]{#1}{day}\fi\rule{0.8cm}{0.4pt}» \ifdefined\hseDateAnchor\hseDateAnchor[2.5cm]{#1}{month_word}\fi\rule{2.5cm}{0.4pt} \hseYear((* if not hse_en *))~г.((* endif *))}
% Отступы строк автора: A над линией подписи (место под рамку подписи, как
% у одного исполнителя), B над строкой даты, C между авторами. В плотном
% листе отступы между абзацами убраны, поэтому A больше, а B и C меньше.
\newcommand{\hseExecutorGapA}{((* if hse_compact *))0.4cm((* else *))0.2cm((* endif *))}
\newcommand{\hseExecutorGapB}{((* if hse_compact *))0.07cm((* else *))0.1cm((* endif *))}
\newcommand{\hseExecutorGapC}{((* if hse_compact *))0.07cm((* else *))0.35cm((* endif *))}
% \hseExecutorRow{<группа>}{<якорь>}{<ФИО>}: три строки одного автора.
\newcommand{\hseExecutorRow}[3]{%
((* if hse_en *))student of group((* else *))студент группы((* endif *)) #1\par\nobreak\vspace{\hseExecutorGapA}%
\hseExecutorSignLine{#2} #3\par\nobreak\vspace{\hseExecutorGapB}%
\hseExecutorDateLine{#2}\par}
\newcommand{\hseExecutorsBlock}{%
((* if team.is_shared_base *))((* if hse_compact *))\setlength{\parskip}{0pt}((* endif *))\textbf{((* if hse_en *))Authors:((* else *))Исполнители:((* endif *))}\par\nobreak
((* for a in project.authors *))
((* if not loop.first *))\vspace{\hseExecutorGapC}((* endif *))%
\hseExecutorRow{%
{{ a.group | default('') | texesc }}}{author__{{ a.slug }}}{%
{{ a.name | texesc }}}
((* endfor *))((* else *))\textbf{((* if hse_en *))Author:((* else *))Исполнитель:((* endif *))}

((* if hse_en *))student of group((* else *))студент группы((* endif *)) \studentgroup

\vspace{0.2cm}

\authorsignatureline{7cm} \studentname

\vspace{0.1cm}

\signdateblank((* endif *))}
