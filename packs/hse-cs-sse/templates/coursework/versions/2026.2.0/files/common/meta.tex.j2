% ФИО в колонке «Фамилия И.О.» заявления о теме (бланк SmartLMS: «Шершаков С.А.»):
% «С. А. Шершаков», «С.А. Шершаков», «Шершаков Сергей Андреевич» → «Шершаков С.А.».
% Слова с точкой или из одной буквы — инициалы, остальные — фамилия; без
% инициалов первое слово — фамилия, остальные сокращаются до первой буквы.
((* macro hse_surname_initials(full) -*))
((*- set ns = namespace(words=[], initials=[]) -*))
((*- for token in (full | string).replace('.', '. ').split() -*))
((*- if token[0].isalpha() and (token | length == 1 or (token | length == 2 and token[1] == '.')) -*))
((*- set ns.initials = ns.initials + [token[0]] -*))
((*- else -*))
((*- set ns.words = ns.words + [token] -*))
((*- endif -*))
((*- endfor -*))
((*- if not ns.initials and ns.words | length > 1 -*))
((*- set ns.initials = ns.words[1:] | map('first') | list -*))
((*- set ns.words = ns.words[:1] -*))
((*- endif -*))
((*- set surname = ns.words | join(' ') -*))
((*- set initials = ns.initials | join('.') ~ ('.' if ns.initials else '') -*))
{{ (surname ~ ' ' ~ initials) | trim }}
((*- endmacro *))
\newcommand{\hseSupervisorShortName}{%
((* if project.supervisor.name *)){{ hse_surname_initials(project.supervisor.name) | texesc }}((* else *))\hseFill{ФИО научного руководителя}((* endif *))}
\newcommand{\hseCoSupervisorShortName}{%
{{ hse_surname_initials(project.co_supervisor.name | default('', true)) | texesc }}}
\newcommand{\hseAcademicSupervisorShortName}{%
{{ hse_surname_initials(project.academic_supervisor.name | default('С. А. Шершаков', true)) | texesc }}}
% Для английской страницы заявления: по умолчанию латиницей, как в бланке.
\newcommand{\hseAcademicSupervisorShortNameEn}{%
((* if project.academic_supervisor.name *)){{ hse_surname_initials(project.academic_supervisor.name) | texesc }}((* else *))Shershakov S.A.((* endif *))}

% Строка даты под подписью: дата ставится от руки или в инструменте «Подписи».
% Год: \hseFormYear (год сборки по Москве или поле form_year), а не
% \hseYear: заявка подписывается осенью, а защита в следующем году.
% Необязательный аргумент: id слота подписи. С ним строка ставит якоря дня
% и месяца (\hseDateAnchor из common/anchors), по ним Студия ставит метки
% даты подписания: \signdateblank[supervisor]. Без аргумента и без
% common/anchors строка печатается как раньше.
\newcommand{\hseIfAnchor}[2]{\if\relax\detokenize{#1}\relax\else\ifdefined\hseDateAnchor#2\fi\fi}
\newcommand{\signdateblank}[1][]{«\hseIfAnchor{#1}{\hseDateAnchor[0.8cm]{#1}{day}}\rule{0.8cm}{0.4pt}» \hseIfAnchor{#1}{\hseDateAnchor[2.5cm]{#1}{month_word}}\rule{2.5cm}{0.4pt} \hseFormYear~г.}

% ── Булевы флаги для условной печати ────────────────────────
\newif\ifhseHasSupervisorTitle
((* if project.supervisor.title or project.supervisor.degree *))\hseHasSupervisorTitletrue((* else *))\hseHasSupervisorTitlefalse((* endif *))
% Консультант указан (есть ФИО): заявление печатает его строку. То же
% условие у пресета маршрута: when {person: co_supervisor}.
\newif\ifhseHasCoSupervisor
((* if project.co_supervisor.name *))\hseHasCoSupervisortrue((* else *))\hseHasCoSupervisorfalse((* endif *))
\newif\ifhseHasNameEn
((* if project.meta.name_en *))\hseHasNameEntrue((* else *))\hseHasNameEnfalse((* endif *))
\newif\ifhseHasAuthorEmail
((* if author.email or (project.authors and project.authors[0].email) *))\hseHasAuthorEmailtrue((* else *))\hseHasAuthorEmailfalse((* endif *))
% Научный руководитель не из ВШЭ (role: company; в настройках «Не из ВШЭ»):
% заявление печатает строку согласия академического руководителя. То же
% условие у пресета маршрута: when {person: supervisor, role: company}.
\newif\ifhseExternalSupervisor
((* if project.supervisor.role == 'company' *))\hseExternalSupervisortrue((* else *))\hseExternalSupervisorfalse((* endif *))
% Редакция заявки: предварительная (PRP, до 15.11) или доработанная (EPP, CP1).
\newif\ifhseExtendedProposal
((* if 'Доработ' in (project.meta.proposal_stage | default('', true)) *))\hseExtendedProposaltrue((* else *))\hseExtendedProposalfalse((* endif *))
% Формат КП (методичка §2.1): проектно-исследовательский или академический.
\newif\ifhseResearchKind
((* if project.kind == 'research' *))\hseResearchKindtrue((* else *))\hseResearchKindfalse((* endif *))
