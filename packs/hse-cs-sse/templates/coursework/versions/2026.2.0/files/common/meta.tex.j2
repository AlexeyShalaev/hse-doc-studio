% ── Год в документах ────────────────────────────────────────
% Два года, у каждого свой смысл:
%   \hseYear      учебный год (год защиты, поле year): титул отчёта, слайды;
%   \hseFormYear  год сборки по Москве: заявление о теме, строки даты под
%                  подписью (заявку подписывают осенью, а защита в следующем
%                  году). Поле form_year задаёт его вручную, пусто: сам.
\newcommand{\hseFormYear}{%
((* if project.meta.form_year *)){{ project.meta.form_year | texesc }}((* elif build.year *)){{ build.year }}((* else *))\the\year((* endif *))}
% «Город, год»: одна строка для всех документов:
%   \hseCityYear            «Москва, 2026» (год сборки, формы);
%   \hseCityYear[\hseYear]  другой год (титулы: учебный год);
%   \hseCityYear*           без запятой: «Москва 2027» (титул по ГОСТ 7.32).
% Город на языке документа (\hseDocCity).
\NewDocumentCommand{\hseCityYear}{s O{\hseFormYear}}{\hseDocCity\IfBooleanTF{#1}{~}{,~}#2}
