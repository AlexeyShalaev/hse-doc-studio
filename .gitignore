# ── Environments ─────────────────────────────────────────────────────────────
.env
.env.test
.env.local
# Голый `.env` НЕ матчит эти имена, а Makefile'ы их ждут:
#   scripts/tests/Makefile:5   TESTS_ENV_FILE = scripts/tests/.env.tests
#   scripts/tools/Makefile:3   TOOLS_ENV_FILE = scripts/tools/.env.tools
.env.tests
.env.tools
.venv
env/
venv/
ENV/

