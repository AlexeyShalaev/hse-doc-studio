# Переменные dev-стенда в Docker (scripts/dev/Makefile -> make run-services).
# Скопируйте при необходимости:  cp scripts/dev/.env.example scripts/dev/.env
# Сам .env в git не попадает; без него всё поднимется на значениях по умолчанию.

# Порт API на хосте (внутри контейнера всегда 8000).
API_PORT=8000

# Порт, на котором крутится Vite-дев-сервер (`make dev`). Нужен только для того,
# чтобы API добавил этот origin в CORS.
WEB_PORT=3000
