# Frontend dev/runtime env vars.
# In .env.development we point axios at the Vite dev server (same origin) so
# the Vite proxy below forwards /api/v1/* to the backend container.
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Overrides the Vite dev proxy target. Defaults to http://localhost:17240
# (matches the backend port from `make run-api`). Use http://localhost:8000
# instead if you run the backend in docker-compose.dev.yml.
# VITE_DEV_PROXY_TARGET=http://localhost:17240
