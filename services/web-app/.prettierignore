# Prettier запускается как `prettier --write .` / `--check .` по всему пакету,
# поэтому генерируемое и вендорное нужно исключать явно — иначе `pnpm format`
# переписывает артефакты сборки, а `pnpm format:check` в CI падает на них.

# Артефакты сборки и покрытия
dist/
coverage/
storybook-static/
node_modules/

# Локфайл генерирует pnpm: переформатирование раздувает его и конфликтует
# с `pnpm install --frozen-lockfile`.
pnpm-lock.yaml

# Патчи пакетов — точные диффы, любое переформатирование их ломает.
patches/
