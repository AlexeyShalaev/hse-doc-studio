# Generated by HSE Doc Studio. Re-create it from the Git settings of the project instead of editing by hand.
# The runner must be able to start Docker (privileged docker:dind or a bound socket).
stages:
  - build
[% if release %]
  - release
[% endif %]

build-documents:
  stage: build
  image:
    name: [[ image ]]
    entrypoint: [""]
    docker:
      user: root
  services:
    - name: docker:27-dind
      alias: docker
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
  script:
    - hse-doc-studio build . [[ docs_args ]] --out [[ out_dir ]]
  artifacts:
    name: documents
    paths:
      - [[ out_dir ]]/
  rules:
[% for rule in rules %]
    - if: '[[ rule ]]'
[% endfor %]
[% if release %]

release-documents:
  stage: release
  image: registry.gitlab.com/gitlab-org/release-cli:latest
  needs:
    - build-documents
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v.+/'
  script:
    - echo "Publishing release $CI_COMMIT_TAG"
  release:
    tag_name: $CI_COMMIT_TAG
    description: "Documents built from $CI_COMMIT_TAG"
    assets:
      links:
        - name: documents
          url: "$CI_PROJECT_URL/-/jobs/artifacts/$CI_COMMIT_TAG/download?job=build-documents"
[% endif %]
