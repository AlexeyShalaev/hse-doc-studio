# Generated by HSE Doc Studio. Re-create it from the Git settings of the project instead of editing by hand.
name: HSE Studio build

on:
[% if push or tag %]
  push:
[% if push %]
    branches: ["**"]
[% endif %]
[% if tag %]
    tags: ["[[ tag_glob ]]"]
[% endif %]
[% endif %]
[% if manual %]
  workflow_dispatch:
[% endif %]

permissions:
  contents: [[ "write" if release else "read" ]]

jobs:
  build:
    runs-on: ubuntu-latest
[% if condition %]
    if: "[[ condition ]]"
[% endif %]
    steps:
      - uses: actions/checkout@v4
      - name: Build documents
        run: |
          docker run --rm --user root \
            -v /var/run/docker.sock:/var/run/docker.sock \
            -v "$PWD:$PWD" -w "$PWD" \
            [[ image ]] \
            hse-doc-studio build . [[ docs_args ]] --out [[ out_dir ]]
      - name: Upload documents
        uses: actions/upload-artifact@v4
        with:
          name: documents
          path: [[ out_dir ]]/*
          if-no-files-found: error
[% if release %]
      - name: Publish release
        if: github.ref_type == 'tag'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          if gh release view "$GITHUB_REF_NAME" > /dev/null 2>&1; then
            gh release upload "$GITHUB_REF_NAME" [[ out_dir ]]/* --clobber
          else
            gh release create "$GITHUB_REF_NAME" [[ out_dir ]]/* --generate-notes
          fi
[% endif %]
