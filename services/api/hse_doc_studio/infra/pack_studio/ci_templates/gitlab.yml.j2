# Generated by HSE Doc Studio [[ studio_version ]] (`hse-doc-studio pack ci init`).
# Re-create it with a newer Studio (new image tag) instead of editing by hand.
# Checks the template packs in the folder [[ packs_path ]]: pack lint, released versions unchanged (releases check and the
# target branch), manifest schemas, version classes and the Studio loader. No TeX, no secrets.
stages:
  - test

hse-packs:
  stage: test
  image:
    name: [[ image ]]
    entrypoint: [""]
    docker:
      user: root
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
    - if: '$CI_PIPELINE_SOURCE == "web"'
  script:
    # Released versions come from the target branch: a merge request may not change or drop their releases.yaml entries.
    - |
      if [ -n "${CI_MERGE_REQUEST_TARGET_BRANCH_NAME:-}" ]; then
        git fetch --no-tags --depth=1 origin "$CI_MERGE_REQUEST_TARGET_BRANCH_NAME"
        hse-doc-studio pack check [[ packs_path ]] --base FETCH_HEAD
      else
        hse-doc-studio pack check [[ packs_path ]]
      fi
