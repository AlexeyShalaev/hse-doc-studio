#!/bin/sh
# Применение принятого push к рабочей папке проекта (вместо updateInstead, стор не в .git папки).
# Корень пакета приходит от сервера (HSE_PYTHON_ROOT): -I не видит PYTHONPATH образа.
exec "$HSE_PYTHON" -I -c 'import os, sys; sys.path.insert(0, os.environ["HSE_PYTHON_ROOT"]); from hse_doc_studio.infra.git_remote.push_to_checkout import main; sys.exit(main(sys.argv[1:]))' "$@"
