# Шаблон переменных. Скопируйте в .env рядом с docker-compose.yml и правьте под себя —
# все значения необязательные, без .env приложение поднимется на значениях по умолчанию.

# Порт на хосте, по которому открывается приложение.
PORT=17240

# Каталог данных на хосте: проекты, настройки, кэш шаблонов, загруженные шрифты.
#
# Путь обязан быть АБСОЛЮТНЫМ. Относительный (`./data`) выглядит рабочим, но им
# не является: `-v` резолвит демон докера, и путь без корня он принимает за ИМЯ
# ТОМА. Приложение при этом поднимается, а вот отдать папку проекта контейнеру
# сборки уже не может — не собирается ни один документ.
#
# Оставите значение относительным или уберёте строку — приложение это заметит и
# при открытии покажет мастер настройки вместо рабочего экрана; папку можно будет
# выбрать прямо в нём. Но compose-установку он чинить не станет: следующий
# `docker compose up -d` вернул бы прежнее значение из этого файла.
#
#   Windows  DATA_DIR=C:/Users/<вы>/hse-studio-data
#   macOS    DATA_DIR=/Users/<вы>/hse-studio-data
#   Linux    DATA_DIR=/home/<вы>/hse-studio-data
DATA_DIR=

# Версия образа. latest — всегда последний релиз; закрепитесь на конкретной
# версии (например 0.2.0), если не хотите обновляться при каждом `docker compose pull`.
TAG=latest

# Группа-владелец /var/run/docker.sock на хосте. Через неё непривилегированный
# пользователь контейнера получает доступ к докеру — без этого не собирается ни один
# документ. 0 подходит для Docker Desktop (Windows/macOS), где сокет принадлежит root:root.
# На Linux сокет обычно root:docker — подставьте `stat -c '%g' /var/run/docker.sock`.
DOCKER_GID=0

# Проверка обновлений. По умолчанию (пусто) приложение раз в сеанс спрашивает у
# GitHub, не вышел ли релиз новее — и показывает это в «О программе». Внутри
# закрытого контура пропишите `off`: тогда в интернет не уйдёт ни одного запроса,
# а «О программе» продолжит работать по последней известной проверке.
# UPDATE_FEED_URL=off

# Папка НА ХОСТЕ со шрифтами, которые просят шаблоны (Times New Roman, Arial,
# Courier New, Consolas). Пусто: Студия сама ищет их в стандартных каталогах ОС.
# На macOS с Docker Desktop это не срабатывает: /System не входит в его File
# Sharing, и бинд /System/Library/Fonts/Supplemental отклоняется («mounts denied»).
# Тогда скопируйте шрифты в папку под домашним каталогом и укажите её здесь:
#   mkdir -p ~/.hse-doc-studio/host-fonts
#   cp /System/Library/Fonts/Supplemental/{Arial,Arial\ Bold,Arial\ Italic,Arial\ Bold\ Italic}.ttf \
#      /System/Library/Fonts/Supplemental/Times\ New\ Roman*.ttf \
#      /System/Library/Fonts/Supplemental/Courier\ New*.ttf ~/.hse-doc-studio/host-fonts/
#   HOST_FONTS_DIR=/Users/<вы>/.hse-doc-studio/host-fonts
# Скрипт install.sh делает это сам. Студия перенесёт шрифты в DATA_DIR/fonts при
# первом старте, если там ещё пусто.
# HOST_FONTS_DIR=

# ── Только для оверлея compose.projects.yml ──────────────────────────────────
# Папка хоста с вашими проектами, если вы не хотите держать их внутри DATA_DIR.
# Абсолютный путь; на Windows работают и прямые, и обратные слэши.
# PROJECTS_HOST_PATH=D:/study/hse

# ── Только для оверлея compose.system-fonts.yml ──────────────────────────────
# Системный каталог шрифтов вашей ОС. Обычно не нужен: Студия сама заглядывает в
# каталог шрифтов хоста (см. HOST_FONTS_DIR выше).
#   Windows  C:/Windows/Fonts
#   Linux    /usr/share/fonts
#   macOS    системный каталог Docker Desktop не отдаёт (контейнер не стартует с
#            «mounts denied»); укажите копию под домашним каталогом, как в HOST_FONTS_DIR.
# SYSTEM_FONTS_PATH=C:/Windows/Fonts
