{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["publicUrl", "database", "s3"],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "publicUrl": {"type": "string", "pattern": "^https?://[^/\\s]+.*$"},
    "trustedProxies": {"type": "array", "items": {"type": "string"}},
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": {"type": "integer", "minimum": 1},
        "runAsGroup": {"type": "integer", "minimum": 1},
        "fsGroup": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "properties": {
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 15},
        "extraEnv": {
          "type": "object",
          "propertyNames": {"pattern": "^HSE_STUDIO__[A-Z0-9_]+$"},
          "additionalProperties": {"type": ["string", "number", "boolean"]}
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClassName": {"type": "string"},
        "accessModes": {"type": "array", "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]}, "minItems": 1},
        "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "annotations": {"type": "object"}
      }
    },
    "backups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingClaim": {"type": "string"},
                "storageClassName": {"type": "string"},
                "accessModes": {"type": "array", "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]}, "minItems": 1},
                "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
                "annotations": {"type": "object"}
              }
            }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["local", "s3"]},
            "name": {"type": "string", "minLength": 1},
            "path": {"type": "string"},
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "bucket": {"type": "string"},
            "prefix": {"type": "string"},
            "pathStyle": {"type": "boolean"},
            "accessKey": {"type": "string"},
            "secretKey": {"type": "string"}
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "kind": {"enum": ["interval", "cron"]},
            "intervalHours": {"type": "integer", "minimum": 1, "maximum": 2160},
            "cron": {"type": "string", "minLength": 9},
            "keepLast": {"type": "integer", "minimum": 0},
            "keepDays": {"type": "integer", "minimum": 0}
          }
        },
        "encryptionMode": {"enum": ["installation", "passphrase"]},
        "passphrase": {"type": "string"},
        "notifyAdmins": {"type": "boolean"}
      }
    },
    "database": {
      "type": "object",
      "properties": {"dsn": {"type": "string", "pattern": "^$|^postgres(ql)?(\\+[a-z0-9]+)?://.+"}},
      "additionalProperties": false
    },
    "s3": {
      "type": "object",
      "required": ["bucket"],
      "properties": {
        "endpoint": {"type": "string"},
        "bucket": {"type": "string", "minLength": 3},
        "region": {"type": "string"},
        "accessKey": {"type": "string"},
        "secretKey": {"type": "string"},
        "publicEndpoint": {"type": "string", "pattern": "^$|^https?://[^/?#@]+/?$"},
        "outsideRunnerAccess": {"enum": ["presigned", "proxy"]},
        "sharedRunnersOutside": {"type": "boolean"},
        "corsOrigins": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "mail": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "username": {"type": "string"},
        "password": {"type": "string"},
        "fromAddress": {"type": "string"}
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "secretsKey": {"type": "string"},
        "runnerBootstrapToken": {"type": "string"},
        "healthToken": {"type": "string"},
        "metricsToken": {"type": "string"},
        "officeJwtSecret": {"type": "string"}
      },
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "languagetoolReplicas": {"type": "array", "items": {"type": "string", "pattern": "^https?://.+"}},
        "officeEditorReplicas": {"type": "array", "items": {"type": "string", "pattern": "^https?://.+"}},
        "backendInternalUrl": {"type": "string", "pattern": "^$|^https?://.+"}
      },
      "additionalProperties": false
    },
    "modelServers": {
      "type": "object",
      "properties": {
        "local": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30},
        "resources": {"type": "object"}
      },
      "additionalProperties": false
    },
    "updater": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "token": {"type": "string"},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "stopTimeoutSeconds": {"type": "integer", "minimum": 30},
        "migrateTimeoutSeconds": {"type": "integer", "minimum": 60},
        "healthTimeoutSeconds": {"type": "integer", "minimum": 60},
        "podStartTimeoutSeconds": {"type": "integer", "minimum": 30}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string"},
        "annotations": {"type": "object"},
        "tls": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}, "secretName": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      },
      "additionalProperties": false
    },
    "runner": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "executor": {"type": "string", "enum": ["docker", "kubernetes"]},
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 64},
        "tags": {"type": "string"},
        "officeUrl": {"type": "string"},
        "dataDir": {"type": "string", "pattern": "^/.+"},
        "dockerSocket": {"type": "string", "pattern": "^/.+"},
        "dockerGid": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "existingClaim": {"type": "string"},
            "storageClassName": {"type": "string"},
            "accessModes": {"type": "array", "items": {"type": "string"}},
            "size": {"type": ["string", "integer"]}
          },
          "additionalProperties": false
        },
        "isolationInfo": {
          "type": "object",
          "properties": {
            "readCluster": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "installFromUi": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "storageClassName": {"type": "string"},
            "storageSize": {"type": ["string", "integer"]},
            "resources": {
              "type": "object",
              "properties": {
                "requests": {"$ref": "#/definitions/podQuantities"},
                "limits": {"$ref": "#/definitions/podQuantities"}
              },
              "required": ["requests", "limits"],
              "additionalProperties": false
            },
            "buildResources": {
              "type": "object",
              "properties": {
                "requests": {"$ref": "#/definitions/podQuantities"},
                "limits": {"$ref": "#/definitions/podQuantities"}
              },
              "required": ["requests", "limits"],
              "additionalProperties": false
            },
            "maxCpu": {"type": ["string", "number"]},
            "maxMemory": {"type": ["string", "number"]}
          },
          "additionalProperties": false
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "apiServerCidrs": {"type": "array", "items": {"type": "string"}},
            "apiServerPorts": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 65535}},
            "extraEgress": {"type": "array"}
          },
          "additionalProperties": false
        },
        "tmpSizeLimit": {"type": ["string", "integer"]},
        "kubernetes": {
          "type": "object",
          "properties": {
            "namespace": {"type": "string"},
            "image": {"type": "string"},
            "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
            "imagePullSecrets": {"type": "array", "items": {"type": "string"}},
            "resources": {
              "type": "object",
              "properties": {
                "requests": {"$ref": "#/definitions/podQuantities"},
                "limits": {"$ref": "#/definitions/podQuantities"}
              },
              "required": ["requests", "limits"],
              "additionalProperties": false
            },
            "workSizeLimit": {"type": ["string", "integer"]},
            "tmpSizeLimit": {"type": ["string", "integer"]},
            "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
            "podStartTimeoutSeconds": {"type": "integer", "minimum": 1},
            "runAsUser": {"type": "integer", "minimum": 1},
            "runAsGroup": {"type": "integer", "minimum": 1},
            "fsGroup": {"type": "integer", "minimum": 1},
            "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
            "tolerations": {"type": "array"},
            "priorityClassName": {"type": "string"},
            "runtimeClassName": {"type": "string"},
            "texCache": {
              "type": "object",
              "properties": {"existingClaim": {"type": "string"}},
              "additionalProperties": false
            },
            "fonts": {
              "type": "object",
              "properties": {"existingClaim": {"type": "string"}},
              "additionalProperties": false
            },
            "networkPolicy": {
              "type": "object",
              "properties": {"enabled": {"type": "boolean"}},
              "additionalProperties": false
            },
            "quota": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "pods": {"type": ["string", "integer"]},
                "requestsCpu": {"type": ["string", "number"]},
                "requestsMemory": {"type": ["string", "number"]},
                "limitsCpu": {"type": ["string", "number"]},
                "limitsMemory": {"type": ["string", "number"]},
                "requestsEphemeralStorage": {"type": ["string", "number"]},
                "limitsEphemeralStorage": {"type": ["string", "number"]}
              },
              "additionalProperties": false
            },
            "limitRange": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "default": {"type": "object"},
                "defaultRequest": {"type": "object"},
                "max": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "podQuantities": {
      "type": "object",
      "properties": {
        "cpu": {"type": ["string", "number"]},
        "memory": {"type": ["string", "number"]},
        "ephemeral-storage": {"type": ["string", "number"]}
      },
      "required": ["cpu", "memory"],
      "additionalProperties": false
    }
  }
}
