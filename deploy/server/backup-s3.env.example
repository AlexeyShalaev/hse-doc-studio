# Переменные оверлея compose.backup-s3.yml. Добавьте строки в .env рядом с docker-compose.yml.
# Ключи отдельные от основного хранилища: не повторяйте S3_ACCESS_KEY и S3_SECRET_KEY.

# Корневые ключи MinIO для бэкапов (нужны только оверлею; Студия их не получает): openssl rand -hex 16
BACKUP_S3_ROOT_USER=backup-root
BACKUP_S3_ROOT_PASSWORD=

# Ключи, которые вводятся в форму назначения в админке. Права только на бакет бэкапов.
BACKUP_S3_ACCESS_KEY=studio-backup
BACKUP_S3_SECRET_KEY=

# Имя закрытого бакета.
BACKUP_S3_BUCKET=hse-backups

# Адрес и порты на хосте. По умолчанию только loopback. Для оверлея на отдельной машине укажите её внутренний
# адрес и поставьте перед S3 прокси с TLS: ключи подписи запросов идут по сети.
BACKUP_S3_BIND=127.0.0.1
BACKUP_S3_PORT=19002
BACKUP_S3_CONSOLE_PORT=19003
