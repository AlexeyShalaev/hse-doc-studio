# Копия этого файла кладётся рядом с docker-compose.yml под именем .env. Секреты хранятся только здесь,
# в compose их нет. Значения помеченные «обязательно» без подстановки останавливают `docker compose up`.

# Версия образа (по умолчанию latest), адрес и порт api на хосте. По умолчанию api слушает только 127.0.0.1:
# обратный прокси с TLS должен работать на том же хосте, иначе задайте BIND_ADDRESS явно.
TAG=latest
BIND_ADDRESS=127.0.0.1
PORT=17240

# Внешний адрес Студии (обязательно). По схеме выбирается Secure у cookie, адрес входит в допустимые Origin.
PUBLIC_URL=https://studio.example.org

# Пароль Postgres (обязательно): openssl rand -hex 24
POSTGRES_PASSWORD=

# Ключ шифрования секретов в базе (обязательно), Fernet: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потеря ключа делает сохранённые секреты нечитаемыми: храните копию отдельно от бэкапа базы.
SECRETS_KEY=

# MinIO (обязательно): ключи и имя закрытого бакета. Те же ключи служат учёткой администратора консоли MinIO.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=studio
# Публичный адрес MinIO (S3 API, не консоль) для тех, кто вне сети compose: браузеры (PDF по ссылке), личные раннеры
# и локальные Студии. Пример: https://files.example.org. Хранилище надо опубликовать за обратным прокси с TLS
# (docs/ru/deploy/runners.md, «Раннеры вне сети сервера»). Пусто значит, что они получают внутренний адрес minio:9000.
S3_PUBLIC_ENDPOINT=
# Если хранилище наружу публиковать нельзя: proxy гонит файлы личных раннеров через api вместо ссылок на S3.
S3_OUTSIDE_RUNNER_ACCESS=presigned
# Консоль MinIO (пользователи, бакеты, метрики): по умолчанию только http://127.0.0.1:19001 на хосте.
# Наружу её не открывайте: доступ через SSH-туннель или обратный прокси с аутентификацией.
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_CONSOLE_PORT=19001
# Метрики Prometheus MinIO на внутреннем порту 9000: public без токена, jwt с токеном из `mc admin prometheus generate`.
MINIO_PROMETHEUS_AUTH_TYPE=public

# Одноразовый токен регистрации раннера (обязательно): openssl rand -hex 32
# api кладёт в базу его хеш при старте. После первого запуска раннера значение можно убрать из api,
# выданный раннеру токен сохранён в его каталоге данных.
RUNNER_BOOTSTRAP_TOKEN=

# Раннер. Каталог данных монтируется по тому же пути на хосте и в контейнере: соседние контейнеры
# сборки видят пути хоста. Каталог создайте заранее и отдайте пользователю контейнера (uid образа).
RUNNER_DATA_DIR=/var/lib/hse-runner
RUNNER_CONCURRENCY=1
# gid сокета докера: Linux `stat -c '%g' /var/run/docker.sock`, Docker Desktop оставьте 0.
DOCKER_GID=0
# Адрес Gotenberg для конвертации офисных файлов; пусто значит раннер не берёт такие задачи.
RUNNER_OFFICE_URL=

# Профиль services: общий секрет JWT для ONLYOFFICE (обязательно, если нужен этот профиль): `openssl rand -hex 32`. Его же
# получает api, поэтому смена секрета требует перезапуска обоих.
ONLYOFFICE_JWT_SECRET=
# Адреса реплик, которые api берёт в пул. Для профиля services раскомментируйте обе строки; пусто значит,
# что проверка текста и редактор офисных файлов недоступны.
# LANGUAGETOOL_REPLICAS=["http://languagetool-1:8010","http://languagetool-2:8010"]
# OFFICE_EDITOR_REPLICAS=["http://onlyoffice"]
LANGUAGETOOL_REPLICAS=[]
OFFICE_EDITOR_REPLICAS=[]

# Обратные прокси перед api: IP или CIDR списком JSON, по ним определяется адрес клиента.
TRUSTED_PROXIES=[]

# Почта (SMTP) для приглашений и сброса пароля; пустой хост выключает отправку.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org

# Bearer-токены для /health/ready с деталями и /metrics; пусто значит детали только админу, /metrics отвечает 404.
HEALTH_TOKEN=
METRICS_TOKEN=

# Ротация логов контейнеров (драйвер json-file): сколько файлов и какого размера хранит каждый контейнер.
# По умолчанию до 5 файлов по 10 МБ; без лимитов логи за годы работы забивают диск хоста.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5

# Автообновление версии (профиль updater): общий секрет api и сервиса-апдейтера, `openssl rand -hex 32`.
# Пусто значит, что Студия только сообщает о новых версиях. Включение: docker compose --profile updater up -d
UPDATER_TOKEN=
