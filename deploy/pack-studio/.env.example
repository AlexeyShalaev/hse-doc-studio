# Переменные профиля Студии шаблонов (deploy/pack-studio/docker-compose.yml).
# Скопируйте в .env рядом с docker-compose.yml и раскомментируйте нужное. Без .env всё работает по умолчанию.

# Порт на этой машине: http://localhost:17260.
# PORT=17260
# Адрес, на котором слушает порт. Входа нет, поэтому по умолчанию только эта машина.
# BIND=127.0.0.1

# Папка с паками (pack.yaml внутри или в подпапке packs/). Абсолютный путь.
# По умолчанию папка, из которой запущен docker compose.
# PACKS_DIR=/Users/me/my-packs

# Данные Студии шаблонов: клоны репозиториев, доступы git, сборки предпросмотра. Абсолютный путь.
# По умолчанию ~/.hse-pack-studio.
# DATA_DIR=/Users/me/.hse-pack-studio

# Linux: свой uid и gid, чтобы Студия могла писать в PACKS_DIR и DATA_DIR (id -u, id -g),
# и gid группы сокета докера (stat -c '%g' /var/run/docker.sock).
# HSE_UID=1000
# HSE_GID=1000
# DOCKER_GID=999

# Версия Студии (тег образа ghcr.io/alexeyshalaev/hse-doc-studio).
# TAG=latest

# Образ TeX Live для предпросмотра (texlive/texlive). Скачивается фоном после старта, несколько гигабайт.
# TEX_IMAGE=texlive/texlive:latest
# false: не скачивать образ сразу после старта, а только при первой сборке.
# TEX_PREFETCH=true

# macOS: Docker Desktop не отдаёт контейнерам /System, где лежат Times New Roman и Arial. Скопируйте их в папку
# под домашним каталогом и укажите её (или загрузите шрифты в Настройках, «Шрифты»). Без них свободные замены.
#   mkdir -p ~/.hse-pack-studio-fonts && cp /System/Library/Fonts/Supplemental/{Arial*,Times\ New\ Roman*}.ttf ~/.hse-pack-studio-fonts/
# HOST_FONTS_DIR=/Users/me/.hse-pack-studio-fonts

# Проверка обновлений: пусто это официальные выпуски, off выключает.
# UPDATE_FEED_URL=
